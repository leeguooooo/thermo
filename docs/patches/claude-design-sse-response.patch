+def rpc_messages(value):
+    messages = value if isinstance(value, list) else [value]
+    if not messages or not all(isinstance(item, dict) for item in messages):
+        raise RuntimeError("Claude Design MCP returned an invalid message")
+    return messages
+
+
+def matching_reply(reply, expected):
+    return ("id" in reply and type(reply["id"]) is type(expected)
+            and reply["id"] == expected and ("result" in reply or "error" in reply))
+
+
+def sse_messages(response):
+    # Parse complete SSE events incrementally. HTTP EOF is not RPC completion.
+    pending = bytearray()
+    data = []
+    scan = 0
+    skip_lf = False
+    first_line = True
+    while True:
+        chunk = response.read1(8192)
+        if not chunk:
+            return  # An unterminated event is not a completed message.
+        pending.extend(chunk)
+        cursor = 0
+        while True:
+            if skip_lf:
+                if cursor == len(pending):
+                    break
+                if pending[cursor] == 10:
+                    cursor += 1
+                skip_lf = False
+                scan = cursor
+            cr = pending.find(b"\r", scan)
+            lf = pending.find(b"\n", scan)
+            endings = [n for n in (cr, lf) if n >= 0]
+            if not endings:
+                scan = len(pending)
+                break
+            end = min(endings)
+            line = bytes(pending[cursor:end])
+            skip_lf = pending[end] == 13
+            cursor = end + 1
+            scan = cursor
+            if first_line:
+                if line.startswith(b"\xef\xbb\xbf"):
+                    line = line[3:]
+                first_line = False
+            if not line:
+                if data:
+                    payload = b"\n".join(data)
+                    data = []
+                    yield json.loads(payload.decode("utf-8"))
+            elif line.startswith(b"data:"):
+                value = line[5:]
+                data.append(value[1:] if value.startswith(b" ") else value)
+        if cursor:
+            del pending[:cursor]
+            scan -= cursor
+
+
